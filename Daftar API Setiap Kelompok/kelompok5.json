{
  "info": {
    "name": "Irtree Dessert API",
    "description": "Koleksi pengujian 8 kelompok API Irtree Dessert. Isi variabel base_url dan phpsessid (cookie PHPSESSID admin dari browser, pada domain yang sama dengan base_url) sebelum menjalankan request bertanda (admin). Variabel test_cookie diisi otomatis untuk hosting dengan pemeriksaan bot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/IrtreeDessert/api"
    },
    {
      "key": "phpsessid",
      "value": "ISI_DENGAN_PHPSESSID_ADMIN"
    },
    {
      "key": "test_cookie",
      "value": "0"
    },
    {
      "key": "menu_id",
      "value": "0"
    },
    {
      "key": "order_id",
      "value": "0"
    },
    {
      "key": "user_id",
      "value": "0"
    },
    {
      "key": "kontak_id",
      "value": "0"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Hosting gratis (InfinityFree) memasang pemeriksaan bot berbasis JavaScript.",
          "// Skrip ini membaca tantangan itu dan menghitung cookie __test otomatis.",
          "const base = pm.collectionVariables.get('base_url') || '';",
          "const lokal = /localhost|127\\.0\\.0\\.1/.test(base);",
          "if (!lokal) {",
          "  pm.sendRequest({ url: base + '/health.php', method: 'GET' }, (err, res) => {",
          "    if (!err && res) {",
          "      const t = res.text();",
          "      const m = t.match(/toNumbers\\(\"([0-9a-f]+)\"\\),b=toNumbers\\(\"([0-9a-f]+)\"\\),c=toNumbers\\(\"([0-9a-f]+)\"\\)/);",
          "      if (m) {",
          "        const CryptoJS = require('crypto-js');",
          "        const key = CryptoJS.enc.Hex.parse(m[1]);",
          "        const iv = CryptoJS.enc.Hex.parse(m[2]);",
          "        const ct = CryptoJS.enc.Hex.parse(m[3]);",
          "        const dec = CryptoJS.AES.decrypt({ ciphertext: ct }, key, { iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.NoPadding });",
          "        pm.collectionVariables.set('test_cookie', dec.toString(CryptoJS.enc.Hex));",
          "      }",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Health dan Info (publik)",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "__test={{test_cookie}}"
              }
            ],
            "url": {
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health.php"
              ],
              "raw": "{{base_url}}/health.php"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET info",
          "request": {
